{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Envy",
  "version": "1.8.1-beta",
  "identifier": "app.envynote.linux",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Envy",
        "width": 800,
        "height": 600,
        "transparent": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage"
    ],
    "publisher": "Skyler Schoos",
    "copyright": "© Skyler Schoos",
    "homepage": "https://envynote.app",
    "shortDescription": "A flat-file, frictionless note-taking application",
    "longDescription": "Envy keeps every note as a plain Markdown file in a folder you choose, so the notes outlive the app. Search, wiki-links, due dates and templates, with no database and no lock-in.",
    "createUpdaterArtifacts": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "linux": {
      "deb": {
        "depends": [
          "webkit2gtk-4.1",
          "libayatana-appindicator3-1"
        ]
      }
    }
  },
  "plugins": {}
}
